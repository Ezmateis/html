<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="css/bootstrap/bootstrap-grid.min.css" />
    <link rel="stylesheet" href="css/styles.css" />
    
    <script defer src="js/bootstrap/bootstrap.bundle.min.js"></script>
    <script defer src="js/script.js"></script>
</head>
<body class="p-3 m-0 border-0 bd-example m-0 border-0">
    <!-- Form controls bootstrap-->
    <div class="mb-3">
      <label for="txtNome" class="form-label">Nome Completo</label>
      <input type="email" class="form-control" id="txtNome" placeholder="EX: Pedro">
    </div>
    <div class="mb-3">
      <label for="txtEndereço" class="form-label">Endereço</label>
      <input type="email" class="form-control" id="txtEndereço" placeholder="EX: 1243981263">
    </div>
    <!-- botao bootstrap-->
    <button type="button" class="btn btn-primary" id="btnButton" onclick="adicionarPessoa()">Salvar</button>
    <!-- Tables bootstrap-->
    <table class="table" id="table">
        <tr>
          <th scope="col">#</th>
          <th scope="col">Nome</th>
          <th scope="col">Endereço</th>
        </tr>
    </table>
  </body>
</html>

============================Script===========================================
var txtNome = document.getElementById("txtNome");
var txtEndereço = document.getElementById("txtEndereço");
var table = document.getElementById("table");
var id = 0;

function adicionarPessoa(){
    id++;
    var nome = txtNome.value;
    var endereço = txtEndereço.value;

    var linha = table.insertRow(); 

    linha.insertCell(). textContent = id;
    linha.insertCell(). textContent = nome;
    linha.insertCell(). textContent = endereço;

    txtNome.value = "";
    txtEndereço.value = "";
}
